---
layout: base.njk
title: Home
---
{% from "macros.njk" import categoryCard %}
<section class="hero">
  <div class="container position-relative">
    <span class="hero-pill">Custom laser engraving studio</span>
    <h1 class="display-3 fw-bold mt-4" style="max-width: 42rem">We turn your ideas into <span class="text-ember">engraved keepsakes</span></h1>
    <p class="lead mt-4 text-white-50" style="max-width: 36rem">{{ site.description }} Every piece is cut, engraved, and finished by hand — made to order, just for you.</p>
    <div class="d-flex flex-wrap gap-3 mt-5">
      <a class="btn btn-ember btn-lg rounded-pill px-4" href="/catalog/">Browse the Catalog →</a>
      <a class="btn btn-outline-light-soft btn-lg rounded-pill px-4" href="/contact/">Get a Custom Quote</a>
    </div>
    <div class="d-flex flex-wrap gap-5 mt-5">
      {% for s in site.stats %}<div><div class="stat-value">{{ s.value }}</div><div class="small text-white-50">{{ s.label }}</div></div>{% endfor %}
    </div>
  </div>
</section>

<section class="py-5 my-4">
  <div class="container">
    <div class="text-center mx-auto mb-5" style="max-width: 40rem">
      <div class="eyebrow">What we make</div>
      <h2 class="display-6 mt-2">Explore our categories</h2>
      <p class="text-secondary">From tree ornaments to wooden games — every design can be personalized.</p>
    </div>
    <div class="row g-4">
      {% for cat in categories %}<div class="col-sm-6 col-lg-4">{{ categoryCard(cat, loop.index0) }}</div>{% endfor %}
    </div>
  </div>
</section>

<section class="bg-ink-soft text-white py-5">
  <div class="container py-4">
    <div class="text-center mx-auto mb-5" style="max-width: 40rem">
      <div class="eyebrow eyebrow-light">Simple process</div>
      <h2 class="display-6 mt-2">How ordering works</h2>
    </div>
    <div class="row g-4">
      <div class="col-md-4"><div class="step h-100"><div class="stat-value">01</div><h5 class="mt-3">Tell us your idea</h5><p class="small text-white-50 mb-0">Pick a category and send us your idea, photo, or design through our quote form.</p></div></div>
      <div class="col-md-4"><div class="step h-100"><div class="stat-value">02</div><h5 class="mt-3">We craft a proof</h5><p class="small text-white-50 mb-0">We confirm material, size, and price, then get your piece ready to engrave.</p></div></div>
      <div class="col-md-4"><div class="step h-100"><div class="stat-value">03</div><h5 class="mt-3">Delivered to your door</h5><p class="small text-white-50 mb-0">Your finished, hand-checked piece ships out or is ready for local pickup.</p></div></div>
    </div>
  </div>
</section>

<section class="py-5 my-4">
  <div class="container"><div class="cta-box">
    <h2 class="display-6">Have something in mind?</h2>
    <p class="mx-auto" style="max-width: 32rem">Send us your idea and we'll get back to you with a quote within 24h.</p>
    <a class="btn btn-outline-light btn-lg rounded-pill px-4" href="/contact/">Start Your Order</a>
  </div></div>
</section>
