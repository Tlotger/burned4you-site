---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: lang
permalink: "{{ lang.prefix }}/"
pagePath: /
eleventyComputed:
  title: "{{ ui[lang.code].nav.home }}"
---
{% from "macros.njk" import categoryCard %}
{% set t = ui[lang.code] %}
<section class="hero">
  <div class="container position-relative">
    <span class="hero-pill">{{ t.home.pill }}</span>
    <h1 class="display-3 fw-bold mt-4" style="max-width: 42rem">{{ t.home.h1Before }} <span class="text-ember">{{ t.home.h1Em }}</span></h1>
    <p class="lead mt-4 text-white-50" style="max-width: 36rem">{{ t.description }} {{ t.home.lead2 }}</p>
    <div class="d-flex flex-wrap gap-3 mt-5">
      <a class="btn btn-ember btn-lg rounded-pill px-4" href="{{ lang.prefix }}/catalog/">{{ t.home.browse }}</a>
      <a class="btn btn-outline-light-soft btn-lg rounded-pill px-4" href="{{ lang.prefix }}/contact/">{{ t.home.secondary }}</a>
    </div>
    <div class="d-flex flex-wrap gap-5 mt-5">
      {% for s in t.stats %}<div><div class="stat-value">{{ s.value }}</div><div class="small text-white-50">{{ s.label }}</div></div>{% endfor %}
    </div>
  </div>
</section>

<section class="py-5 my-4">
  <div class="container">
    <div class="text-center mx-auto mb-5" style="max-width: 40rem">
      <div class="eyebrow">{{ t.home.catsEyebrow }}</div>
      <h2 class="display-6 mt-2">{{ t.home.catsTitle }}</h2>
      <p class="text-secondary">{{ t.home.catsText }}</p>
    </div>
    <div class="row g-4">
      {% for cat in categories[lang.code] %}<div class="col-sm-6 col-lg-4">{{ categoryCard(cat, loop.index0, t, lang.prefix) }}</div>{% endfor %}
    </div>
  </div>
</section>

<section class="bg-ink-soft text-white py-5">
  <div class="container py-4">
    <div class="text-center mx-auto mb-5" style="max-width: 40rem">
      <div class="eyebrow eyebrow-light">{{ t.home.processEyebrow }}</div>
      <h2 class="display-6 mt-2">{{ t.home.processTitle }}</h2>
    </div>
    <div class="row g-4">
      {% for s in t.home.steps %}
      <div class="col-md-4"><div class="step h-100"><div class="stat-value">{{ s.n }}</div><h5 class="mt-3">{{ s.title }}</h5><p class="small text-white-50 mb-0">{{ s.text }}</p></div></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="py-5 my-4">
  <div class="container"><div class="cta-box">
    <h2 class="display-6">{{ t.home.ctaTitle }}</h2>
    <p class="mx-auto" style="max-width: 32rem">{{ t.home.ctaText }}</p>
    <a class="btn btn-outline-light btn-lg rounded-pill px-4" href="{{ lang.prefix }}/contact/">{{ t.home.ctaButton }}</a>
  </div></div>
</section>
