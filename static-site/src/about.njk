---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: lang
permalink: "{{ lang.prefix }}/about/"
pagePath: /about/
eleventyComputed:
  title: "{{ ui[lang.code].nav.about }}"
---
{% set t = ui[lang.code] %}
<section class="bg-ink text-white py-5">
  <div class="container py-4">
    <div class="eyebrow eyebrow-light">{{ t.about.eyebrow }}</div>
    <h1 class="display-5 mt-2" style="max-width: 40rem">{{ t.about.title }}</h1>
    <p class="text-white-50 mt-3" style="max-width: 40rem">{{ t.about.text }}</p>
  </div>
</section>
<section class="py-5"><div class="container"><div class="row g-4">
  {% for v in t.about.values %}
  <div class="col-md-4"><div class="card-b4y"><div class="body"><h3>{{ v.title }}</h3><p class="desc mb-0">{{ v.text }}</p></div></div></div>
  {% endfor %}
</div></div></section>
<section class="bg-cream-soft py-5"><div class="container text-center">
  <h2 class="mb-4">{{ t.about.ctaTitle }}</h2>
  <a class="btn btn-ember btn-lg rounded-pill px-4" href="{{ lang.prefix }}/contact/">{{ t.about.ctaButton }}</a>
</div></section>
