---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: lang
permalink: "{{ lang.prefix }}/contact/"
pagePath: /contact/
eleventyComputed:
  title: "{{ ui[lang.code].nav.contact }}"
scripts:
  - /js/contact.js
---
{% set t = ui[lang.code] %}
<section class="py-5 my-3"><div class="container"><div class="row g-4 g-lg-5">
  <div class="col-lg-5">
    <div class="eyebrow">{{ t.contact.eyebrow }}</div>
    <h1 class="display-5 mt-2">{{ t.contact.title }}</h1>
    <p class="text-secondary">{{ t.contact.text }}</p>
    <dl class="mt-4 small">
      <dt>{{ t.contact.email }}</dt><dd class="text-secondary">{{ site.email }}</dd>
      <dt>{{ t.contact.phone }}</dt><dd class="text-secondary">{{ site.phone }}</dd>
      <dt>{{ t.contact.studio }}</dt><dd class="text-secondary">{{ t.location }}</dd>
    </dl>
  </div>
  <div class="col-lg-7"><form class="form-card" action="{{ site.formEndpoint }}" method="POST">
    <input type="hidden" name="language" value="{{ lang.code }}">
    <div class="row g-3">
      <div class="col-sm-6"><label class="form-label fw-semibold" for="name">{{ t.contact.name }}</label><input class="form-control" id="name" name="name" required></div>
      <div class="col-sm-6"><label class="form-label fw-semibold" for="email">{{ t.contact.email }}</label><input class="form-control" id="email" name="email" type="email" required></div>
      <div class="col-sm-6"><label class="form-label fw-semibold" for="category">{{ t.contact.category }}</label>
        <select class="form-select" id="category" name="category"><option value="">{{ t.contact.general }}</option>
          {% for c in categories[lang.code] %}<option value="{{ c.slug }}">{{ c.name }}</option>{% endfor %}
        </select></div>
      <div class="col-sm-6"><label class="form-label fw-semibold" for="item">{{ t.contact.item }}</label><input class="form-control" id="item" name="item"></div>
      <div class="col-12"><label class="form-label fw-semibold" for="message">{{ t.contact.message }}</label><textarea class="form-control" id="message" name="message" rows="5" required placeholder="{{ t.contact.placeholder }}"></textarea></div>
      <div class="col-12"><button class="btn btn-ember rounded-pill px-4" type="submit">{{ t.contact.send }}</button></div>
    </div>
  </form></div>
</div></div></section>
