{% macro delay(i) %}{% if i < 6 %}{{ i * 45 }}{% else %}270{% endif %}{% endmacro %}

{% macro categoryCard(cat, i, t, prefix) %}
{% set n = cat.products | length %}
<a class="card-b4y drop-in" href="{{ prefix }}/catalog/{{ cat.slug }}/" style="--drop-in-delay: {{ delay(i) | trim }}ms">
  <div class="card-img-wrap"><img src="{{ cat.heroImage }}" alt="{{ cat.name }}" {% if i == 0 %}fetchpriority="high"{% else %}loading="lazy"{% endif %}></div>
  <div class="body">
    <div class="eyebrow">{{ cat.tagline }}</div>
    <h3>{{ cat.name }}</h3>
    <p class="desc">{{ cat.description }}</p>
    <span class="fw-semibold" style="color: var(--ember-600)">{% if n == 1 %}{{ t.catalog.viewOne }}{% else %}{{ t.catalog.viewMany | replace("{n}", n) }}{% endif %}</span>
  </div>
</a>
{% endmacro %}

{% macro productCard(p, catSlug, i, t, prefix) %}
<div class="card-b4y tall drop-in" style="--drop-in-delay: {{ delay(i) | trim }}ms">
  <div class="card-img-wrap"><img src="{{ p.image }}" alt="{{ p.name }}" {% if i == 0 %}fetchpriority="high"{% else %}loading="lazy"{% endif %}></div>
  <div class="body">
    <h3>{{ p.name }}</h3>
    <p class="desc">{{ p.description }}</p>
    <p class="small fw-semibold mb-3" style="color: rgba(43,28,18,.6)">{{ t.catalog.material }} <span class="fw-normal">{{ p.material }}</span></p>
    <div class="d-flex justify-content-between align-items-center gap-2">
      <span class="small fw-semibold" style="color: var(--ember-600)">{{ t.catalog.madeToOrder }}</span>
      <a class="btn btn-ember btn-sm rounded-pill px-3" href="{{ prefix }}/contact/?item={{ p.name | urlencode }}&category={{ catSlug }}">{{ t.catalog.ask }}</a>
    </div>
  </div>
</div>
{% endmacro %}
