---
layout: base.njk
pagination:
  data: categories
  size: 1
  alias: category
permalink: "/catalog/{{ category.slug }}/"
eleventyComputed:
  title: "{{ category.name }}"
  description: "{{ category.description }}"
---
{% from "macros.njk" import productCard %}
<section class="py-5 my-3">
  <div class="container">
    <a class="fw-semibold small text-decoration-none" href="/catalog/">← All categories</a>
    <div class="d-flex flex-column flex-md-row align-items-md-center gap-4 mt-3">
      <img src="{{ category.heroImage }}" alt="{{ category.name }}" fetchpriority="high" class="rounded-4 flex-shrink-0" style="width: 16rem; max-width: 100%; height: 10rem; object-fit: cover">
      <div>
        <div class="eyebrow">{{ category.tagline }}</div>
        <h1 class="display-6 mt-1">{{ category.name }}</h1>
        <p class="text-secondary mb-0" style="max-width: 40rem">{{ category.description }}</p>
      </div>
    </div>
    <div class="row g-4 mt-4">
      {% for p in category.products %}<div class="col-sm-6 col-lg-4">{{ productCard(p, category.slug, loop.index0) }}</div>{% endfor %}
    </div>
  </div>
</section>
